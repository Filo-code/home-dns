# home-dns environment template.
# Values are intentionally EMPTY. Never put real secrets in this file.
#
# Development: copy to .env (git-ignored) and load it into your shell when needed:
#   set -a; source .env; set +a
# The application itself never reads .env files.
# Production (Stage C): secrets go into a systemd EnvironmentFile with mode 0600.

# ---- Selection (A0) ----
# development | production (default: development)
HOME_DNS_ENV=
# Directory containing app/<env>.yaml (default: ./config in a source checkout)
HOME_DNS_CONFIG_DIR=

# ---- Optional overrides of profile values (A0), nested with "__" ----
# HOME_DNS_API__BIND_HOST=
# HOME_DNS_API__PORT=

# ---- Secrets ----
# Pi-hole v6 app password for the backend; required only when dns_provider.kind=pihole_v6 (C2)
HOME_DNS_PIHOLE_APP_PASSWORD=
# Telegram (A6) — names may be refined when A6 is specified
HOME_DNS_TELEGRAM_BOT_TOKEN=
HOME_DNS_TELEGRAM_CHAT_ID=
