# home-dns environment template
# Copy to .env on the Raspberry Pi (never commit .env), then:
#   chmod 600 .env
# Values are intentionally EMPTY. Do not put real secrets in this file.
# Production deployments will load secrets via a systemd EnvironmentFile
# with restrictive permissions (see docs/security.md, Phase 12–14).

# ---- Paths (proposed layout, CLAUDE.md §17; confirm after Raspberry Pi audit) ----
HOME_DNS_BASE_DIR=
HOME_DNS_CONFIG_DIR=
HOME_DNS_DATA_DIR=
HOME_DNS_LOG_DIR=
HOME_DNS_BACKUP_DIR=

# ---- Pi-hole API (ADR 0001) ----
# Base URL of the Pi-hole API reachable from the dashboard backend, e.g. http://<pi-lan-address>
PIHOLE_API_URL=
# Dedicated Pi-hole *app password* for the backend (not the admin web password)
PIHOLE_APP_PASSWORD=

# ---- Telegram alerting (Phase 13) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Dashboard (Phase 14; stack not yet decided, see ADR 0005 when written) ----
DASHBOARD_BIND_ADDRESS=
DASHBOARD_PORT=
DASHBOARD_SESSION_SECRET=
